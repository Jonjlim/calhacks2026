# Copy to fetch-agent/.env (git-ignored). Never commit real values.

# --- Fetch.ai (required) ---
# Long, private random phrase. It determines the agents' addresses; keep it stable and secret.
AGENT_SEED=
# Optional per-agent seeds. Unset: derived from AGENT_SEED + role, so one AGENT_SEED
# gives five stable addresses (the Courier uses AGENT_SEED itself). `python print_addresses.py` lists them.
COURIER_SEED=
ARCHIVIST_SEED=
MUSE_SEED=
SCOUT_SEED=
KEEPER_SEED=
# agents (default): the Courier asks the specialist uAgents; local: in-process role functions only.
COUNCIL_MODE=agents
# Seconds the Courier waits for each specialist before using its local fallback.
COUNCIL_ARCHIVIST_TIMEOUT_S=25
COUNCIL_MUSE_TIMEOUT_S=20
COUNCIL_SCOUT_TIMEOUT_S=110
COUNCIL_KEEPER_TIMEOUT_S=20
# ASI:One API key (asi1.ai → Dashboard → API keys). Optional: enables ASI:One reasoning for the Archivist, Muse and Keeper.
ASI1_API_KEY=
AGENT_NAME=unwrap-gift-council
AGENT_PORT=8001
# Set to 0 to use only the deterministic rules (faster on slow Wi-Fi).
COUNCIL_USE_LLM=1

# --- Unwrap backend (Convex) ---
# Your deployment's HTTP actions URL: https://<deployment>.convex.site  (NOT the .convex.cloud URL)
CONVEX_SITE_URL=
# Optional: comma-separated .convex.site URLs a run may name as its callbackSite (e.g. dev and prod). Defaults to CONVEX_SITE_URL.
COUNCIL_ALLOWED_SITES=
# Shared secret; must match `npx convex env set COUNCIL_INGEST_SECRET ...` on the deployment.
COUNCIL_INGEST_SECRET=
# Shared secret the website uses to start runs on this agent (must match the Next.js server env).
COUNCIL_AGENT_SECRET=
# Optional: mirror ASI:One chats under this demo key so /council?watch=<key> animates them live.
COUNCIL_BROADCAST_KEY=

# --- Research fallback (only if Convex is not configured) ---
# Apify API token (console.apify.com → Settings → Integrations). Each search is capped at $0.20.
APIFY_TOKEN=
COUNCIL_RESEARCH_TIMEOUT_S=90
