# Copy to fetch-agent/.env (git-ignored). Never commit real values.

# --- Fetch.ai (required) ---
# Long, private random phrase. It determines the agent's address; keep it stable and secret.
AGENT_SEED=
# ASI:One API key (asi1.ai → Dashboard → API keys). Optional: enables model-assisted clue extraction.
ASI1_API_KEY=
AGENT_NAME=unwrap-gift-council
AGENT_PORT=8001
# Set to 0 to use only the deterministic Archivist (faster on slow Wi-Fi).
COUNCIL_USE_LLM=1

# --- Unwrap backend (Convex) ---
# Your deployment's HTTP actions URL: https://<deployment>.convex.site  (NOT the .convex.cloud URL)
CONVEX_SITE_URL=
# Shared secret; must match `npx convex env set COUNCIL_INGEST_SECRET ...` on the deployment.
COUNCIL_INGEST_SECRET=
# Shared secret the website uses to start runs on this agent (must match the Next.js server env).
COUNCIL_AGENT_SECRET=
# Optional: mirror ASI:One chats under this demo key so /council?watch=<key> animates them live.
COUNCIL_BROADCAST_KEY=

# --- Research fallback (only if Convex is not configured) ---
# Apify API token (console.apify.com → Settings → Integrations). Each search is capped at $0.20.
APIFY_TOKEN=
COUNCIL_RESEARCH_TIMEOUT_S=90
