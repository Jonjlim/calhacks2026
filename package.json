    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.65",
