{
  "name": "unwrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "dev:agent": "fetch-agent/.venv/bin/python fetch-agent/agent.py",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p gift-twin",
    "test": "vitest run",
    "twin": "node --env-file-if-exists=.env.local gift-twin/cli.ts",
    "test:twin": "node --test 'gift-twin/test/*.test.ts'",
    "convex:login": "convex login",
    "convex:auth:setup": "npx @convex-dev/auth",
    "convex:deploy:dev": "convex dev --once",
    "convex:deploy:prod": "convex deploy --yes",
    "convex:deploy:prod:dry": "convex deploy --yes --dry-run",
    "agents:smoke": "UNWRAP_LIVE_AGENT_SMOKE=1 node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run convex/agents/live-smoke.test.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.96",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@xyflow/react": "12.12.0",
    "convex": "1.48.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.14.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.9",
    "@types/three": "0.186.0",
    "convex-test": "0.0.65",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
