# Copy to .env.local. Never commit real values.
# Written automatically by `npx convex dev`:
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Server-side secrets live in the Convex dashboard (npx convex env set ...),
# not here. Provider choices are unverified until Phase 0 spikes pass.
# LLM_BASE_URL=       (Dev 3: HTTPS API base ending in /v1, not a completion URL)
# LLM_MODEL=          (Dev 3: explicitly configured model supporting JSON mode)
# LLM_API_KEY=        (Dev 3)
# LLM_MAX_OUTPUT_TOKENS=2400  (256–8192; includes reasoning tokens where supported)
# LLM_REASONING_EFFORT=none  (optional; set only if the chosen model supports it)
# RECIPIENT_AGENT_DEMO_ENABLED=true  (optional synthetic organizer-as-recipient demo only)
# GIFT_TWIN_DEMO_ENABLED=true  (Convex env; lets organizers pair a recipient's Mac companion. The twin agent uses the LLM_* settings above. See docs/GIFT_TWIN.md)
# GIFT_TWIN_MOSS_ENABLED=true  (Convex env; optional local semantic memory for twin idea evaluations)
# MOSS_PROJECT_ID=            (Convex only; from the Moss portal)
# MOSS_PROJECT_KEY=           (Convex secret; never NEXT_PUBLIC_. No message cloud indexing.)
# MOSS_ROOM_ENABLED=true      (Convex env; Moss ranks the guide's "I don't know" nudge, D28. Off = word overlap)
# Moss voice, D29 — Next.js SERVER env (never NEXT_PUBLIC_). Set all three or the "Talk to Moss" button stays hidden:
# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=
# MOSS_VOICE_AGENT_ID=        (from the Moss Platform; deploy the agent with scripts/moss-voice/deploy.py)
# Moss's natural narration voice, D30 — Next.js SERVER env (never NEXT_PUBLIC_):
# ELEVENLABS_API_KEY=         (run `npx -y @elevenlabs/cli@latest onboard init`, which stores it in .env.local. Without it Moss uses the browser voice.)
# ELEVENLABS_VOICE_ID=        (optional; default "Sarah" EXAVITQu4vr4xnSDxMaL, a young soft American female voice)
# ELEVENLABS_MODEL_ID=        (optional; default eleven_v4, the most natural. eleven_flash_v2_5 is fastest and cheapest)

# --- Gift Twin Mac companion (read by `npm run twin` on the recipient's Mac, never by Convex) ---
# GIFT_TWIN_CONVEX_URL=        (defaults to NEXT_PUBLIC_CONVEX_URL)
# APIFY_TOKEN=        (Dev 4)
# STRIPE_SECRET_KEY=  (Dev 4, P1-B only, test mode)
# PAYMENTS_SANDBOX_ENABLED=true  (Dev 2, P1-B only; off = pledges only)

# --- AI Council (Fetch.ai) — Next.js server only; never NEXT_PUBLIC_ ---
# Your deployment's HTTP actions URL (https://<deployment>.convex.site).
# CONVEX_SITE_URL=
# Must equal the deployment's secret: npx convex env set COUNCIL_INGEST_SECRET <value>
# COUNCIL_INGEST_SECRET=
# Where the coordinator's REST endpoint listens, and the shared secret it checks.
# FETCH_AGENT_URL=http://127.0.0.1:8001
# COUNCIL_AGENT_SECRET=

# Invite links and QR codes use the host page's actual origin.
# Open the app through the address you want guests to use (including its port).
